# Copy to .env to override defaults (see app/core/config.py for all settings).
DATABASE_URL=sqlite:///./duolingo.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Minutes to regenerate one heart (shortened for demos).
HEART_REGEN_MINUTES=60
SEED_ON_STARTUP=true
# Exposes /api/dev/* (simulated clock, reset). Keep on for the demo.
ENABLE_DEV_TOOLS=true
